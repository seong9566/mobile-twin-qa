# 회사 프로젝트는 git에 올리지 않는다
/company/*
!/company/README.md

# 받아 둔 소스
/.cache/

# 규칙 수정용 워크트리
/.claude/worktrees/

# macOS 앱 빌드 결과물
/app/.build/
/app/QATwin.app/

# 기기별 설정·비밀값
project.local.yaml
!/templates/project.local.yaml
!/app/Tests/QATwinCoreTests/Fixtures/**/project.local.yaml
.env
.env.*
!.env.example

# 실행 원본 결과물
**/runs/**/artifacts/
!/app/Tests/QATwinCoreTests/Fixtures/**/artifacts/

.DS_Store
